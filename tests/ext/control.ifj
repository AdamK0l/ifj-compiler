import ifj26.*

@main def run(): Unit =
    var x = -5
    val absolute = if x < 0 then 0 - x else x // v 'absolute' je hodnota 5
    val abs2 = if x < 0 then
        0 - x
    else
        x
    val abs3 = if x < 0 then 0 - x else
        x
    for i <- 1 to 10 by 2 do
        print(i)
    val limit = 10
    for
        i <- 0 until limit
        if i != 3
        if i < 8
    do
        print(i)
    for j <- 0 until 3 do print(j)
    if x < 0 then
        print("negative")
    else if x == 0 then
        print("zero")
    if x > 0 then print("pos") else print("nonpos")
