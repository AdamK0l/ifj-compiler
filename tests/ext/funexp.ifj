import ifj26.*

def factorial(n: Int): Int =
    if n < 2 then
        return 1
    else
        return n * factorial(n - 1)

@main def run(): Unit =
    val result = 2 * factorial(readInt() + 1)
    print(toStr(result + strLength(subStr("abcd", 1, 3))))
    val b: Boolean = !(result > 3) && true || false
    val d = (1.5).toInt + "abc".length
    print(b)
