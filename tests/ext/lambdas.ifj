import ifj26.*

// běžná funkce
def foo(x: Int) = x + 5
// běžná funkce přijímající jinou funkci jako svůj parametr
def bar(a: Int, f: (Int) => Boolean) =
    val result = f(a) // volání funkce přijaté z parametru
    if result then
        print("f uspelo")
    else
        print("f neuspelo")
// funkce, co vrací funkci
def goo(): (Int) => String =
    return (a: Int) =>
        val strA = toStr(a)
        "cislo" + strA

@main def main(): Unit =
    val add: (Int, Int) => Int =
        (left: Int, right: Int) => left + right // lambda (anonymní) funkce
    val positive = (value: Int) => value > 0 // vyžaduje implementaci BOOLTHEN,
                                             // typem je (Int) => Boolean
    val addFive: (Int) => Int = foo // do proměnné je možné přiřadit běžnou
                                     // funkci, ale musí být explicitně otypovaná

    // volání funkcí uložených v proměnných
    val x = add(10, 8)
    val y = addFive(x)
    bar(y, positive)
